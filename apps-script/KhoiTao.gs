ội dung","Nội dung EN","Loại","Loại EN","Xe","Ngày đăng","Nguồn","Trạng thái","Người duyệt","Tạo lúc","Người tạo","Cập nhật lúc"],["TT-20261105-001","vf3-tra-gop-moi-thang","Mua VF 3 trả góp, mỗi tháng trả bao nhiêu?","Buying a VF 3 on instalments: how much per month?","Ví dụ tính trả góp cho VF 3 Eco với mức trả trước 15%.","An instalment example for the VF 3 Eco with a 15% down payment.","VF 3 có giá từ 285.000.000 đồng cho bản Eco và 296.000.000 đồng cho bản Plus. Dưới đây là ví dụ cho bản Eco, vay 5 năm.\n\nGiá trị xe | 285.000.000\nƯu đãi (3%) | -8.550.000\nTrả trước (15%) | 41.467.500\nSố tiền vay | 234.982.500\n= Tháng đầu trả | 5.952.890\n\n~ Giá tại ngày đăng. Minh họa theo một gói mẫu, lãi suất 10,4%/năm trong 12 tháng đầu. Chưa gồm phí đăng ký.\n\nMỗi ngân hàng có gói vay khác nhau, và tiền trả giảm dần theo dư nợ. Quý khách vui lòng liên hệ để nhận báo giá phù hợp.\n\n[Xem VF 3 và tính trả góp ›](/vf3/)","The VF 3 starts at 285,000,000 VND for the Eco and 296,000,000 VND for the Plus. Below is an example for the Eco over 5 years.\n\nValue | 285,000,000\nPromotion (3%) | -8,550,000\nDown payment (15%) | 41,467,500\nLoan amount | 234,982,500\n= First month | 5,952,890\n\n~ Price on the publishing date. Illustration using a sample package at 10.4% a year for the first 12 months. Excludes registration fees.\n\nEach bank has different packages, and the amount falls month by month as the balance reduces. Please contact us for a quote that fits your plan.\n\n[View VF 3 and calculate instalments ›](/vf3/)","Kinh nghiệm","Guide","vf3","05/11/2026","","Đã đăng","Giang","05/11/2026 17:00:00","Claude","05/11/2026 17:00:00"],["TT-20261105-002","vinfast-vuot-moc-100000-xe","VinFast vượt mốc 100.000 ô tô bán ra sau 3 quý","VinFast passes 100,000 cars sold in three quarters","Lũy kế đến hết quý III/2025 đạt 103.884 xe, dẫn đầu là VF 3 và VF 5.","Sales reached 103,884 cars by the end of Q3 2025, led by the VF 3 and VF 5.","Theo công bố của VinFast ngày 11/10/2025, hãng đã bán 103.884 ô tô điện trong 9 tháng đầu năm 2025, riêng tháng 9 là 13.914 xe.\n\nVF 3 | 31.386\nVF 5 | 30.956\nVF 6 | 14.425\nVF 7 | 5.877\n\n~ Số xe bán ra trong 9 tháng đầu năm 2025.\n\nVới khách đang chọn xe đầu tiên, số liệu này cho thấy VF 3 và VF 5 là hai dòng được chọn nhiều nhất. Quý khách có thể đến SAMCO Bình Tân để lái thử cả hai xe và so sánh trực tiếp.","According to VinFast on 11/10/2025, the company sold 103,884 electric cars in the first nine months of 2025, including 13,914 in September.\n\nVF 3 | 31,386\nVF 5 | 30,956\nVF 6 | 14,425\nVF 7 | 5,877\n\n~ Cars sold in the first nine months of 2025.\n\nFor first-time buyers, these figures show the VF 3 and VF 5 are the most chosen models. You are welcome to test drive both at SAMCO Binh Tan and compare them yourself.","Tin VinFast","VinFast news","vf5","11/10/2025","https://vinfastauto.com/vn_vi/vinfast-lap-ky-luc-viet-nam-can-moc-100000-o-to-ban-ra-trong-3-quy-dau-nam","Đã đăng","Giang","05/11/2026 17:00:00","Claude","05/11/2026 17:00:00"]],"DANG_KY":[["ID","Họ tên","SĐT","Email","Dòng xe","Nhu cầu","Ngày mong muốn","Trạng thái","Người phụ trách","Màu","Tạo lúc","Người tạo","Cập nhật lúc"]],"_DanhMuc":[["Nhu cầu","Trạng thái đăng ký","Người phụ trách","Trạng thái bài"],["Tư vấn","Chờ gọi","","Chờ duyệt"],["Lái thử","Đang tư vấn","","Đã đăng"],["","Hoàn tất","","Ẩn"],["","Không liên lạc được","",""]],"_CauHinh":[["Khóa","Giá trị"],["SĐT","083-309-1307"],["Địa chỉ","1135 Quốc Lộ 1A, Phường Tân Tạo, Quận Bình Tân"],["Địa chỉ EN","1135 National Route 1A, Tan Tao Ward, Binh Tan District"],["Trả trước tối thiểu (%)",15],["Email nhận đăng ký",""]],"BC_DangKy":[["Dòng xe","Tư vấn","Lái thử","Tổng"],["VF 2"],["VF 3"],["VF 5"],["VF 6"],["VF 7"],["VF 8"],["VF 9"],["Limo Green"],["MPV 7"],["EC Van"],["Minio Green"],["VF Wild"]]};
const MAU_TIEU_DE = { DANG_KY: '#147a44', _DanhMuc: '#667085', _CauHinh: '#667085', BC_DangKy: '#667085' };

function khoiTao() {
  const ss = SpreadsheetApp.getActive();
  const co = ss.getSheetByName('XE');
  if (co && co.getLastRow() > 1) throw 'Sheet đã có dữ liệu nên không khởi tạo lại.';
  const cu = ss.getSheets();
  Object.keys(SEED).forEach(ten => {
    const s = ss.getSheetByName(ten) || ss.insertSheet(ten), v = SEED[ten], h = v[0];
    v.slice(1).forEach(r => { while (r.length < h.length) r.push(''); });
    // Cột có chữ để dạng văn bản, tránh Sheet tự đổi ngày hoặc mất số 0 đầu
    h.forEach((k, c) => {
      const toanSo = v.length > 1 && v.slice(1).every(r => typeof r[c] === 'number' || r[c] === '');
      if (!toanSo) s.getRange(1, c + 1, Math.max(v.length, 2000), 1).setNumberFormat('@');
    });
    s.getRange(1, 1, v.length, h.length).setValues(v);
    s.getRange(1, 1, 1, h.length).setFontWeight('bold').setFontColor('#ffffff').setBackground(MAU_TIEU_DE[ten] || '#1f4e8c').setWrap(true).setVerticalAlignment('middle');
    s.setFrozenRows(1);
    s.setColumnWidths(1, h.length, 130);
  });
  // Không xuống dòng ở các cột nội dung dài, để hàng không cao quá
  ss.getSheetByName('TIN_TUC').getRange(2, 1, 50, SEED.TIN_TUC[0].length).setWrap(false);
  ['XE', 'PHIEN_BAN', 'BAO_HIEM'].forEach(ten => {
    const s = ss.getSheetByName(ten), h = SEED[ten][0];
    ['Giá niêm yết', 'TNDS', 'Phí đăng ký, biển số (tạm ẩn, chưa dùng)'].forEach(k => {
      const c = h.indexOf(k); if (c >= 0) s.getRange(2, c + 1, 500, 1).setNumberFormat('#,##0');
    });
  });
  // Danh sách chọn
  const coKhong = SpreadsheetApp.newDataValidation().requireValueInList(['Có', 'Không']).build();
  ['XE', 'PHIEN_BAN', 'GOI_VAY', 'MAU_XE'].forEach(ten => {
    const s = ss.getSheetByName(ten);
    s.getRange(2, SEED[ten][0].indexOf('Hiện web') + 1, 500, 1).setDataValidation(coKhong);
  });
  ss.getSheetByName('XE').getRange(2, SEED.XE[0].indexOf('Lái thử') + 1, 500, 1).setDataValidation(coKhong);
  const dm = ss.getSheetByName('_DanhMuc');
  const theoCot = (cot) => SpreadsheetApp.newDataValidation().requireValueInRange(dm.getRange(2, cot, 49, 1), true).setAllowInvalid(true).build();
  const dk = ss.getSheetByName('DANG_KY');
  dk.getRange(2, SEED.DANG_KY[0].indexOf('Trạng thái') + 1, 2000, 1).setDataValidation(theoCot(2));
  dk.getRange(2, SEED.DANG_KY[0].indexOf('Người phụ trách') + 1, 2000, 1).setDataValidation(theoCot(3));
  ss.getSheetByName('TIN_TUC').getRange(2, SEED.TIN_TUC[0].indexOf('Trạng thái') + 1, 500, 1).setDataValidation(theoCot(4));
  // Báo cáo tự đếm từ DANG_KY
  const bc = ss.getSheetByName('BC_DangKy');
  SEED.BC_DangKy.slice(1).forEach((r, i) => {
    const h = i + 2;
    bc.getRange(h, 2, 1, 3).setFormulas([[`=COUNTIFS(DANG_KY!$E:$E,$A${h},DANG_KY!$F:$F,"Tư vấn")`, `=COUNTIFS(DANG_KY!$E:$E,$A${h},DANG_KY!$F:$F,"Lái thử")`, `=B${h}+C${h}`]]);
  });
  // Email nhận thông báo là email của chủ Sheet
  const ch = ss.getSheetByName('_CauHinh'), dong = SEED._CauHinh.findIndex(r => r[0] === 'Email nhận đăng ký');
  ch.getRange(dong + 1, 2).setValue(Session.getEffectiveUser().getEmail());
  ch.setColumnWidth(2, 380);
  cu.forEach(s => { if (!SEED[s.getName()]) ss.deleteSheet(s); });
  ss.setActiveSheet(ss.getSheetByName('DANG_KY'));
  CacheService.getScriptCache().remove('data');
}
